# Chaves da ADEX (Configurações -> Chaves API). Nunca commitar o .env real.
# Use pk_test_/sk_test_ para testar antes de trocar pelas chaves live.
ADEX_PUBLIC_KEY=
ADEX_SECRET_KEY=

# Segredo exibido ao cadastrar o webhook no painel da ADEX (valida x-webhook-signature)
ADEX_WEBHOOK_SECRET=

# Sites autorizados a chamar esta API (separados por vírgula, sem barra no final), ou * para qualquer site
ALLOWED_ORIGINS=https://SEU-DOMINIO.com.br,https://www.SEU-DOMINIO.com.br

# URL pública desta API (Railway). Usada como postbackUrl do webhook.
PUBLIC_API_URL=https://SEU-APP.up.railway.app

# Unidade do campo "amount" enviado à ADEX. Confirmado em cobrança de teste (21/09/2026): "reais".
ADEX_AMOUNT_UNIT=reais

# Só para testar a tela sem chamar a ADEX (gera Pix falso que "paga" após 20s). Nunca em produção.
MOCK_ADEX=false

# Token da API da UTMify (Integrações -> Webhooks -> Credenciais de API). Sem ele, nada é enviado.
UTMIFY_API_TOKEN=
# Enquanto não for "false", os pedidos vão para a UTMify como TESTE (isTest=true: ela só valida, não grava).
# Depois da compra de teste de ponta a ponta, troque para false para as vendas contarem.
UTMIFY_TEST=true

# Porta do Railway (Networking -> porta alvo)
PORT=8080
